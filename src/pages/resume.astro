---
import NavBar from "../components/NavBar.astro"
import Layout from "@/layouts/Layout.astro";
import Footer from "../components/footer.astro";
---

<Layout title = 'Resume'>
	<NavBar />
	<div class= "container">
		<div class = "resume-header">
			<div class = "left" > 
				<h1> ☆ Resume </h1>
				<h3> My professional experience and qualifications</h3>
			</div>
			<div class = "right">
				<a href="https://drive.google.com/file/d/1wmJAdAx4VDeMcPCHt6tFy_NRkG8F-6cS/view?usp=sharing" class = "button"> 
          <img src = "/Portfolio/images/icons/downloads.png" /> Download PDF </a>
			</div>
		</div>

		<div class = "section-header">
			<div class="icon work">
      			<img src="/Portfolio/images/icons/laptop.png"/>
    		</div>  
			<h2> Experience </h2>
		</div>

    <div class = "card">
      <p class = "title"> CS/DS NSAR Ambassador</p>
      <div class = "left-right">
        <p class = "employer"> University of Illinois Chicago College of Engineering </p>
        <p class = "date"> May 2026 - Present </p> 
      </div>
      <ul>
        <li> Guiding CS/DS Transfer and New students through course registration and hold removals </li>
        <li> Discussing CS/DS coursework and audit credit alongside placement tests </li>
        <li> Supporting students through their new student onboarding process </li>
      </ul>
    </div>

    <div class = "card">
      <p class = "title"> Health Access Lab Research Intern </p>
      <div class = "left-right">
        <p class = "employer"> Innovation Center </p>
        <p class = "date"> Feb 2026 - Present </p> 
      </div>
      <ul>
        <li> Researching and developing innovative healthcare solutions using Apple’s software ecosystem, with the focus of improving health access and usability </li>
        <li> Working in an interdisciplinary team to analyze health access patterns, synthesize findings and define scope </li>
      </ul>
    </div>

    <div class = "card">
      <p class = "title"> Sandbox Labratory Assistant </p>
      <div class = "left-right">
        <p class = "employer"> Innovation Center </p>
        <p class = "date"> Feb 2026 - Present </p> 
      </div>
      <ul>
        <li> Supporting hands-on learning experiences focused on Swift programming and Apple developer tools as part of Apple’s Community Education Initiative </li>
        <li> Collaborating with lab and teaching staff to facilitate immersive, community-focused technology events </li>
      </ul>
    </div>
    <div class = "card">
      <p class = "title"> Teaching Assistant - Computer Design </p>
      <div class = "left-right">
        <p class = "employer"> University of Illinois at Chicago</p>
        <p class = "date"> Jan 2026 - Present </p>
      </div>
      <ul>
        <li> Assisted students in debugging C/C++ code and troubleshooting circuit designs to fix wiring issues and improve understanding </li>
        <li> Co-Led hands on lab sessions and collaborated with teaching assistants to explain complex computer design concepts and prepare students for upcoming coursework </li>
        <li> Provided technical guidance for semester-long group projects, helping teams overcome challenges and successfully complete their goals</li>
      </ul>
    </div>
		<div class = "card">
			<p class = "title"> Web Developer</p>
			<div class = "left-right">
				<p class = "employer"> Women in Computer Science @ UIC </p>
				<p class = "date"> Sept 2025 - Dec 2025 </p>
			</div>
			<ul> 
				<li> Built a full-stack e-commerce website for SweetT Bakery with customizable product ordering, checkout flow, and live order tracking for customers </li> 
				<li> Implemented a Node.js + Express REST API with MongoDB to manage products, customers, and orders, including order status pipeline </li>
				<li> Developed an admin portal with authentication/authorization, enabling staff to log in, view incoming orders, update order status, and manage products </li>
				<li> Designed a custom order builder (size, flavors, fillings, decorations) using Astro + Tailwind </li>
				<li> Collaborated with a team of 15 students using Git Version Control (branches, pull requests, code reviews) </li>
			</ul>
		</div> 
		<div class = "card">
			<p class = "title"> Research Assistant - Detecting Emotions in Large Language Models </p>
			<div class = "left-right"> 
				<p class = "employer"> University of Illinois at Chicago </p>
				<p class = "date"> June 2025 - Aug 2025 </p>
			</div>
			<ul> 
				<li> Read academic papers related to LLM exhibition of emotions, and interacted with existing LLM’s to determine whether they behave in a way that exhibits emotions </li> 
				<li> Determined whether the emotions are correlated with some hardware or software signatures </li>
				<li> Utilized Python and Ollama to recreate data from research papers to test its validity </li>
			</ul>
		</div> 
		<div class="card">
    		<p class = "title">Teaching Assistant - Mathematical Foundations of Computing</p>
			<div class = "left-right">
				<p class = "employer"> University of Illinois at Chicago </p>
				<p class = "date"> Jan 2025 - May 2025 </p>
			</div>
			<ul> 
				<li> Host weekly, in-person office hours to assist students understanding of logic, quantifiers, sets and proofs </li>
				<li> Co-lead lab sessions of 25+ students, answering questions about discrete mathematics and propositional logic </li>
				<li> Grade students labs and update grades on BlackBoard (university-wide learning management system) </li>
				<li> Monitor Piazza discussion platform for questions about the course and its material </li>
			</ul>
  		</div>

		<div class = "section-header">  
      		<div class="icon education">
      			<img src="/Portfolio/images/icons/education.png"/>
    		</div> 
			<h2> Education </h2>
		</div>
		 <div class="card">
    		<p class = "title"> Bachelor of Science in Computer Science and minor in Mathematics</p>
			<p2> University of Illinois at Chicago | 2024 - 2027 </p2>
			<div class = "tags"> 
				<p class = "extra"> GPA: 4.0/4.0</p>
			</div>
			<p class = "title"> Relevant Coursework: </p>
			<div class = "tags2"> 
				<p> Data Structures & Algorithms </p>
				<p> Web Development</p>
				<p> Machine Organization </p>
				<p> Program Design</p>
				<p> Languages and Automata </p>
				<p> Software Design</p>
				<p> Computer Design </p>
        <p> Systems Programming </p>
        <p> Game Development & Design </p>
			</div>
  		</div>

		<div class = "section-header">  
      		<div class="icon skills">
      			<img src="/Portfolio/images/icons/code.png"/>
    		</div> 
			<h2> Skills </h2>
		</div>
		<div class="card">
    		<p> Programming languages </p>
			<div class = "tags"> 
				<p> C </p>
				<p> C++ </p>
				<p> C# </p>
				<p> JavaScript </p>
				<p> Python </p>
				<p> Java </p>
				<p> HTML </p>
				<p> CSS </p>
        <p> Dart </p>
        <p> Swift </p>
        <p> F# </p>
        <p> SQL </p>
			</div>
		
			<p> Frameworks & Libraries </p>
			<div class = "tags2"> 
				<p> Node.js </p>
				<p> Astro </p>
				<p> Express </p>
				<p> React </p>
        <p> Flutter </p>
			</div>

			<p> Tools & Technologies </p>
			<div class = "tags3"> 
				<p> Git </p>
				<p> MongoDB </p>
				<p> AWS </p>
        <p> Figma </p>
        <p> Unity 3D </p>
			</div>

			<p> Concepts </p>
			<div class = "tags4"> 
				<p> API </p>
				<p> Data Structures </p>
				<p> Algorithms </p>
			</div>
  		</div>
		
		<div class = "section-header">
      		<div class="icon special">
      			<img src="/Portfolio/images/icons/award-ribbon.png"/>
    		</div> 
			<h2> Certifications and Awards </h2>
		</div>
		<div class="card">
      <div class = "lightBox"> <p> CITI Program: Research Security and Integrity (June 2026)</p> </div>
			<div class = "lightBox"> <p> Apple Certification: App Development with Swift – Associate (Dec 2025)</p> </div>
			<div class = "lightBox"> <p> Academic Achievement: University of Illinois Chicago's College of Engineering Dean's List</p>
				<ul> <li> Fall 2024, Spring 2025, Fall 2025 </li></ul> </div>
			<div class = "lightBox"> <p> Award: Fitch Group 2024 Codeathon Runner Up</p> </div>
  		</div>
	</div>
</Layout>

<style>
.container{
  max-width: 1400px;
  margin: 0 auto;
  padding-top: 1rem;
  padding-left: 3rem;
  padding-right: 3rem;
}

.button {
  display: inline-flex;
  padding: 0.8rem 1.8rem;
  background: linear-gradient(135deg, #8330ffa8, #3374ffba, #55e3ffa4);
  border-radius: 999px;
  border: none;
  color: white;
  font-size: 1rem;
  cursor: pointer;
  transition: 0.25s ease;
  text-decoration: none;
}

.button:hover {
  transform: translateY(-3px);
}

.button img {
  width: 20px;
  height: 20px;
  margin-right: 12px;
}

.card {
  margin-top: 1rem;
  padding: 2.2rem 2.5rem;
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.95);
}

.card .title {
	margin-top: 0rem;
	margin-bottom: 0.4rem;
	font-weight: bold;
}

.card .employer {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-bottom: 0rem;
  margin-top: 0rem;

  padding: 0.45rem 0.9rem;
  border-radius: 999px;
  font-weight: 500;
  color: white;
  background: linear-gradient(135deg, #e66465, #a78bfa);
}

.card .date {
  color: #7d52ffff;
}

.tags, .tags2, .tags3, .tags4 {
  display: flex;
  flex-wrap: wrap;
  column-gap: 0.6rem;
  row-gap: 0.6rem;
}

.tags .extra{
  margin-top: 0.6rem;
  margin-bottom: 0.6rem;
}

.tags p, .tags2 p, .tags3 p, .tags4 p {
  padding: 0.45rem 0.9rem;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 500;
  color: white;
  margin: 0.2rem;
}

.left-right {
  display:flex; 
  align-items: center;
  gap: 1rem; 
  margin-top: 0rem;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin: 1.5rem 0 1.5rem;
}

.section-header h2 {
  font-size: 1.8rem;
  font-weight: 600;
  font-family: 'twinkle star', cursive;
}

.section-header .icon {
  width: 56px;
  height: 56px;
  border-radius: 12px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.section-header .icon img {
  width: 75%;
}

.section-header .icon.work, .tags p  {
  background: linear-gradient( #e66465, #a78bfa);
}

.section-header .icon.education, .tags2 p {
	background: linear-gradient(135deg, #93c5fd, #c4b5fd);
}
.section-header .icon.skills, .tags3 p{
	background: linear-gradient(135deg, #a7f3d0, #c4b5fd);
}

.section-header .icon.special, .tags4 p {
	background: linear-gradient(135deg, #fbbf24, #f9a8d4);
}

.card .lightBox {
  padding: 0.45rem 0.9rem 0.45rem;
  border-radius: 999px;
  background: #f9a8d48e;
  margin: 1rem;
}

.card .lightBox:hover{
	transform: translateY(-3px);
}

ul {
  margin-top: 0.4rem; 
  margin-bottom: 0rem;
}

li {
  margin-bottom: 0.4rem;
}

.resume-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0rem;
}

.resume-header h1, .resume-header h3 {
  margin: 0;
}

.resume-header h3 {
  margin-top: 0.4rem;
}

.resume-header .left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.resume-header .right {
  display: flex;
  justify-content: flex-end;
}

@media (max-width: 600px) {
  .resume-header {
    flex-direction: column;
    align-items: stretch;
  }

  .resume-header .right {
    justify-content: flex-start;
  }
  
  .left-right {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  ul {
	padding-left: 0;
	margin-left: 0;
	list-style-position: inside;
	/* list-style: none; // use this for no bullet points*/
  }

  li {
	margin-left: 0;
  }

  .card {
    border-radius: 16px;
    padding: 1.4rem 1.2rem;
  }

  .card .employer, .tags p, .tags2 p, .tags3 p, .tags4 p {
    border-radius: 12px;
	padding: 0.35rem 0.7rem;
  }

  .card .employer, .card .date{
	margin-top: 0.3rem;
  }

  .card .lightBox {
    border-radius: 14px;
    margin: 0.6rem 0;
  }

  .tags, .tags2, .tags3, .tags4 {
    gap: 0.35rem;
  }

  .container {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .resume-header {
    gap: 1rem;
  }

  .resume-header .right {
    justify-content: flex-start;
  }

  .button {
    width: fit-content;
  }

  .section-header {
    gap: 0.75rem;
  }

  .section-header .icon {
    width: 44px;
    height: 44px;
  }

  .button {
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
    gap: 0.5rem;
  }

  .button img {
    width: 16px;
    height: 16px;
    margin-right: 6px;
  }
}
</style>