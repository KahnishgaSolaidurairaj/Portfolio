---
import NavBar from "../components/NavBar.astro"
import Layout from "@/layouts/Layout.astro";
import Footer from "../components/footer.astro";
import {
  resumeHeader,
  experiences,
  education,
  skillCategories,
  certifications,
} from "../data/resumeInfo";
---

<Layout title = 'Resume'>
	<NavBar />
	<div class= "container">
		<div class = "resume-header">
			<div class = "left" > 
				<h1> {resumeHeader.title} </h1>
				<h3> {resumeHeader.subtitle} </h3>
			</div>
			<div class = "right">
				<a href={resumeHeader.pdfDownloadUrl} class = "button"> 
          <img src = "/Portfolio/images/icons/downloads.png" /> Download PDF </a>
			</div>
		</div>

		<div class = "section-header">
			<div class="icon work">
      			<img src="/Portfolio/images/icons/laptop.png"/>
    		</div>  
			<h2> Experience </h2>
		</div>

    {experiences.map((experience) => (
      <div class = "card">
        <div class="experience-top">
          <div class="employer-icon">
            <div class="employer-icon-inner">
              <img src={experience.icon} alt={`${experience.employer} logo`} />
            </div>
          </div>
          <div class="experience-headline">
            <p class = "title"> {experience.title}</p>
            <div class = "left-right">
              <p class = "employer"> {experience.employer}</p>
              <p class = "date"> {experience.date} </p> 
            </div>
          </div>
        </div>
        <ul class="experience-details">
          {experience.responsibilities.map((responsibility) => (
            <li> {responsibility} </li>
          ))}
        </ul>
      </div>
    ))}

		<div class = "section-header">  
      		<div class="icon education">
      			<img src="/Portfolio/images/icons/education.png"/>
    		</div> 
			<h2> Education </h2>
		</div>
		 <div class="card">
    		<p class = "title"> {education.degree}</p>
			<p2> {education.school} </p2>
			<div class = "tags"> 
				<p class = "extra"> {education.gpa}</p>
			</div>
			<p class = "title"> Relevant Coursework: </p>
			<div class = "tags2"> 
				{education.coursework.map((course) => (
          <p> {course} </p>
        ))}
			</div>
  		</div>

		<div class = "section-header">  
      		<div class="icon skills">
      			<img src="/Portfolio/images/icons/code.png"/>
    		</div> 
			<h2> Skills </h2>
		</div>
		<div class="card">
      {skillCategories.map((category) => (
        <>
          <p> {category.name} </p>
          <div class={category.tagClass}> 
            {category.skills.map((skill) => (
              <p> {skill} </p>
            ))}
          </div>
        </>
      ))}
  		</div>
		
		<div class = "section-header">
      		<div class="icon special">
      			<img src="/Portfolio/images/icons/award-ribbon.png"/>
    		</div> 
			<h2> Certifications and Awards </h2>
		</div>
		<div class="card">
      {certifications.map((certification) => (
        certification.previewUrl || certification.openUrl ? (
          <a
            href={`/Portfolio/resume/certifications/${certification.id}`}
            target="_blank"
            rel="noopener noreferrer"
            class={`certification-link ${certification.variant}`}
          >
            <p> {certification.title} </p>
            {certification.subItems && (
              <ul>
                {certification.subItems.map((subItem) => (
                  <li> {subItem} </li>
                ))}
              </ul>
            )}
          </a>
        ) : (
          <div class={certification.variant}>
            <p> {certification.title} </p>
            {certification.subItems && (
              <ul>
                {certification.subItems.map((subItem) => (
                  <li> {subItem} </li>
                ))}
              </ul>
            )}
          </div>
        )
      ))}
  		</div>
	</div>
</Layout>

<style>
.container{
  max-width: 1400px;
  margin: 0 auto;
  padding-top: 1rem;
  padding-left: 3rem;
  padding-right: 3rem;
}

.button {
  display: inline-flex;
  padding: 0.8rem 1.8rem;
  background: linear-gradient(135deg, #8330ffa8, #3374ffba, #55e3ffa4);
  border-radius: 999px;
  border: none;
  color: white;
  font-size: 1rem;
  cursor: pointer;
  transition: 0.25s ease;
  text-decoration: none;
}

.button:hover {
  transform: translateY(-3px);
}

.button img {
  width: 20px;
  height: 20px;
  margin-right: 12px;
}

.card {
  margin-top: 1rem;
  padding: 2.2rem 2.5rem;
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.95);
}

.card .title {
	margin-top: 0rem;
	margin-bottom: 0.4rem;
	font-weight: bold;
}

.experience-top {
  --employer-icon-size: 72px;
  --employer-icon-gap: 1.25rem;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--employer-icon-gap);
}

.experience-headline {
  flex: 1;
  min-width: 0;
}

.employer-icon {
  width: var(--employer-icon-size);
  height: var(--employer-icon-size);
  padding: 4px;
  border-radius: 14px;
  flex-shrink: 0;
  box-sizing: border-box;
  background: linear-gradient(135deg, #e66465, #a78bfa);
}

.employer-icon-inner {
  width: 100%;
  height: 100%;
  border-radius: 10px;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.employer-icon img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 10px;
  display: block;
}

.experience-details {
  margin-top: 0.75rem;
  margin-left: calc(var(--employer-icon-size) + var(--employer-icon-gap));
  padding-left: 1rem;
}

.card .employer {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-bottom: 0rem;
  margin-top: 0rem;

  padding: 0.45rem 0.9rem;
  border-radius: 999px;
  font-weight: 500;
  color: white;
  background: linear-gradient(135deg, #e66465, #a78bfa);
}

.card .date {
  color: #7d52ffff;
}

.tags, .tags2, .tags3, .tags4 {
  display: flex;
  flex-wrap: wrap;
  column-gap: 0.6rem;
  row-gap: 0.6rem;
}

.tags .extra{
  margin-top: 0.6rem;
  margin-bottom: 0.6rem;
}

.tags p, .tags2 p, .tags3 p, .tags4 p {
  padding: 0.45rem 0.9rem;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 500;
  color: white;
  margin: 0.2rem;
}

.left-right {
  display:flex; 
  align-items: center;
  gap: 1rem; 
  margin-top: 0rem;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin: 1.5rem 0 1.5rem;
}

.section-header h2 {
  font-size: 1.8rem;
  font-weight: 600;
  font-family: 'twinkle star', cursive;
}

.section-header .icon {
  width: 56px;
  height: 56px;
  border-radius: 12px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.section-header .icon img {
  width: 75%;
}

.section-header .icon.work, .tags p  {
  background: linear-gradient( #e66465, #a78bfa);
}

.section-header .icon.education, .tags2 p {
	background: linear-gradient(135deg, #93c5fd, #c4b5fd);
}
.section-header .icon.skills, .tags3 p{
	background: linear-gradient(135deg, #a7f3d0, #c4b5fd);
}

.section-header .icon.special, .tags4 p {
	background: linear-gradient(135deg, #fbbf24, #f9a8d4);
}

.card .lightBox {
  padding: 0.45rem 0.9rem 0.45rem;
  border-radius: 999px;
  background: #f9a8d48e;
  margin: 1rem;
}

.certification-link {
  display: block;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
}

.certification-link:hover {
	transform: translateY(-3px);
}

.card .lightBox:hover, .card .lightBox2:hover{
	transform: translateY(-3px);
}

.card .lightBox2 {
  padding: 0.45rem 0.9rem 0.45rem;
  border-radius: 999px;
  background: #f9cea88e;
  margin: 1rem;
}

ul {
  margin-top: 0.4rem; 
  margin-bottom: 0rem;
}

li {
  margin-bottom: 0.4rem;
}

.resume-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0rem;
}

.resume-header h1, .resume-header h3 {
  margin: 0;
}

.resume-header h3 {
  margin-top: 0.4rem;
}

.resume-header .left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.resume-header .right {
  display: flex;
  justify-content: flex-end;
}

@media (max-width: 600px) {
  .resume-header {
    flex-direction: column;
    align-items: stretch;
  }

  .resume-header .right {
    justify-content: flex-start;
  }
  
  .left-right {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .experience-top {
    --employer-icon-size: 56px;
    --employer-icon-gap: 0.75rem;
    align-items: flex-start;
  }

  .employer-icon {
    padding: 3px;
    border-radius: 12px;
  }

  .employer-icon-inner,
  .employer-icon img {
    border-radius: 9px;
  }

  .experience-details {
    padding-left: 0.75rem;
  }

  ul {
	padding-left: 0;
	margin-left: 0;
	list-style-position: inside;
	/* list-style: none; use this for no bullet points */
  }

  li {
	margin-left: 0;
  }

  .card {
    border-radius: 16px;
    padding: 1.4rem 1.2rem;
  }

  .card .employer, .tags p, .tags2 p, .tags3 p, .tags4 p {
    border-radius: 12px;
	padding: 0.35rem 0.7rem;
  }

  .card .employer, .card .date{
	margin-top: 0.3rem;
  }

  .card .lightBox {
    border-radius: 14px;
    margin: 0.6rem 0;
  }

  .card .lightBox2 {
    border-radius: 14px;
    margin: 0.6rem 0;
  }
  
  .tags, .tags2, .tags3, .tags4 {
    gap: 0.35rem;
  }

  .container {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .resume-header {
    gap: 1rem;
  }

  .resume-header .right {
    justify-content: flex-start;
  }

  .button {
    width: fit-content;
  }

  .section-header {
    gap: 0.75rem;
  }

  .section-header .icon {
    width: 44px;
    height: 44px;
  }

  .button {
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
    gap: 0.5rem;
  }

  .button img {
    width: 16px;
    height: 16px;
    margin-right: 6px;
  }
}
</style>
