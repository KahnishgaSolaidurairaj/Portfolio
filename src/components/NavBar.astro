<style>
.nav {
  background: #a7a7ffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  border-radius: 0px;

  position: sticky;
  top: 0;
  z-index: 999;
}

.left {
  font-family: "Verdana";
  color: #323e83ff;
  justify-content: flex-start;
}

.left a {
  text-decoration: none;
  color: #323e83ff;
}

.links {
  display: flex;
  gap: 2rem;
}

.links a {
  font-weight: 300;
  font-family: "Verdana";
  color: #323e83ff;
  justify-content: flex-end;
  transition: color 0.2s ease;
  text-decoration: none;
}

.links a:hover {
  color: #c4297eff;
}

.menu-btn {
  display: none;
  font-size: 1.8rem;
  background: none;
  border: none;
  cursor: pointer;
  color: #323e83ff;
}

@media (max-width: 800px) {
  .menu-btn {
    display: block;
  }

  .links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 1rem;
    background: #a7a7ffff;
    flex-direction: column;
    width: 100px;

    padding: 1rem;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  }

  .links.open {
    display: flex;
    background: white;
    margin-left: auto;
  }
}

</style>

<script>
  const btn = document.querySelector(".menu-btn");
  const links = document.querySelector("#nav-links");
  btn?.addEventListener("click", () => {links.classList.toggle("open");});
  links?.querySelectorAll("a").forEach(link => link.addEventListener("click", () => {links.classList.remove("open");}));
</script>
